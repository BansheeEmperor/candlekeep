# ChromaDB Connection
CHROMA_URL=http://localhost:8000
CHROMA_AUTH_TOKEN=

# Embedding Model (minilm, bge-small, nomic)
CANDLEKEEP_EMBEDDING=bge-small

# Document Processing
CANDLEKEEP_CHUNK_SIZE=512
CANDLEKEEP_CHUNK_OVERLAP=50

# Sparse backend for hybrid path (bm25 or colbert)
# ColBERT requires: pip install candlekeep[colbert]
CANDLEKEEP_SPARSE_BACKEND=bm25

# Personality (true/false)
CANDLEKEEP_SPICE=false

# Transport mode (stdio or http)
CANDLEKEEP_TRANSPORT=stdio

# HTTP mode settings (only used when CANDLEKEEP_TRANSPORT=http)
CANDLEKEEP_HTTP_HOST=127.0.0.1
CANDLEKEEP_HTTP_PORT=8111

# Bearer token for HTTP auth (optional, recommended for non-localhost)
CANDLEKEEP_MCP_TOKEN=

# Rate limiting (HTTP mode only, per MCP session, 0 = disabled)
CANDLEKEEP_RATE_LIMIT_SEARCH=30
CANDLEKEEP_RATE_LIMIT_WRITE=5
CANDLEKEEP_RATE_LIMIT_WINDOW=60

# LLM Provider (anthropic, openai, bedrock, openai_compat)
# Used by RAPTOR summaries (R04). Leave blank to disable.
CANDLEKEEP_LLM_PROVIDER=
CANDLEKEEP_LLM_MODEL=

# Vision Provider (anthropic, openai, bedrock, openai_compat)
# Used by VLM captioning (R07). Leave blank to disable.
CANDLEKEEP_VLM_PROVIDER=
CANDLEKEEP_VLM_MODEL=

# Provider API keys (set the ones you need)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoints (Ollama, LM Studio, vLLM)
CANDLEKEEP_LLM_BASE_URL=http://localhost:11434/v1
CANDLEKEEP_VLM_BASE_URL=http://localhost:11434/v1

# Bedrock: uses standard AWS credential chain + AWS_REGION
# pip install candlekeep[bedrock]
AWS_REGION=us-east-1
